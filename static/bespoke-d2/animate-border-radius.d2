vars: {
  d2-config: {
    animate-interval: 1200ms
    animate-duration: 900ms
  }
}

engine: Audio engine
control: Capture control {
  width: 48
  height: 48
  label.near: outside-bottom-center
  style: {
    fill: tomato
    stroke: tomato
    border-radius: 24
  }
}
engine -> control: capture state

steps: {
  recording: {
    control.style.border-radius: 4
  }
}
