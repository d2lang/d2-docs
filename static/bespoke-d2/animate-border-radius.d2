vars: {
  d2-config: {
    animate-interval: 1200ms
    animate-duration: 900ms
  }
}

engine: Audio engine
control: Record {
  width: 48
  height: 48
  label.near: outside-bottom-center
  style: {
    fill: tomato
    stroke: tomato
    border-radius: 24
  }
}
engine -> control: ready

steps: {
  recording: {
    control: Stop
    control.style.border-radius: 4
    (engine -> control)[0]: capture started
  }
}
