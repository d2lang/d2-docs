vars: {
  d2-config: {
    animate-interval: 1s
    animate-duration: 800ms
  }
}

base: Base aerial imagery {
  style.fill: darkseagreen

  strip: New flight strip {
    width: 194
    style.fill: "linear-gradient(to right, lightskyblue 0%, lightskyblue 35%)"
  }
}

steps: {
  blend-overlap: {
    base.strip.style.fill: "linear-gradient(to right, transparent 0%, lightskyblue 35%)"
  }
}
