vars: {
  d2-config: {
    animate-interval: 1s
    animate-duration: 800ms
  }
}

delivery: "POST /webhooks/orders" {
  event: "order.paid\nAttempt 2 of 3" {
    shape: text
    style.font-color: darkslategray
  }
}

steps: {
  third-failure: {
    delivery.event: "order.paid\nDead-lettered" {style.font-color: firebrick}
  }
}
