vars: {
  d2-config: {
    animate-interval: 1s
    animate-duration: 800ms
  }
  angle: 0
  camera: "#a7d3ed"
  slides: "#ffdb9c"
}

camera: Camera {style.fill: ${camera}}
slides: Slides {style.fill: ${slides}}
program: "Wipe · ${angle}°" {
  width: 180
  height: 76
  style.fill: "linear-gradient(${angle}deg, ${camera} 50%, ${slides} 50%)"
}
camera -> program
slides -> program

steps: {
  quarter-turn: {vars: {angle: 90}}
}
