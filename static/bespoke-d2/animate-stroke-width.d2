vars: {
  d2-config: {
    animate-interval: 1200ms
    animate-duration: 900ms
  }
}

router: Read router
east: East replica
west: West replica
router -> east: {style.stroke-width: 8}
router -> west: {style.stroke-width: 2}

steps: {
  shift-west: {
    (router -> east)[0].style.stroke-width: 2
    (router -> west)[0].style.stroke-width: 8
  }
  shift-east: {
    (router -> east)[0].style.stroke-width: 8
    (router -> west)[0].style.stroke-width: 2
  }
}
