vars: {
  d2-config: {
    animate-interval: 1s
    animate-duration: 800ms
  }
  area: "radial-gradient(circle, lightskyblue 22%, whitesmoke 24%)"
}

map: "Driver search" {
  label.near: outside-top-center
  grid-rows: 1
  grid-gap: 0
  style.fill: ${area}
  width: 210
  height: 210

  *.shape: text
  *.width: 58
  west: Cab A
  pickup: Pickup
  east: Cab B
}

steps: {
  widen-search: {
    vars: {area: "radial-gradient(circle, lightskyblue 78%, whitesmoke 80%)"}
  }
}
