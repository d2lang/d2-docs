vars: {
  d2-config: {
    animate-interval: 1s
    animate-duration: 800ms
  }
  glow: "radial-gradient(circle, lightskyblue 10%, white 70%)"
}

Signal: {
  shape: circle
  width: 100
  height: 100
  style.fill: ${glow}
}

steps: {
  expand: {
    vars: {glow: "radial-gradient(circle, plum 50%, white 100%)"}
  }
}
