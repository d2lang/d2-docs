vars: {
  d2-config: {
    isometric: true
    layout-engine: tala
    pad: 10
  }
}

style.fill: "#fcf7eb"
direction: right

classes: {
  paper-path: {
    style: {stroke: "#32434c"; stroke-width: 4}
  }
  deck: {
    style: {
      fill: "#c2d2cf"
      stroke: "#153c43"
      stroke-width: 2
      font-size: 30
      font-color: "#102c32"
      bold: true
    }
    label.near: bottom-left
  }
  ink: {
    shape: cylinder
    width: 86
    height: 77
    style: {stroke: "#21383b"; stroke-width: 2; font-size: 34; bold: true}
  }
  roller: {
    shape: queue
    width: 150
    height: 50
    style: {stroke-width: 2}
  }
}

machine: Four-color press {
  label.near: bottom-left
  style: {
    fill: "#355866"
    stroke: "#203d47"
    stroke-width: 2
    font-color: "#f8eedc"
    font-size: 33
    bold: true
  }
  inks: Ink fountains {
    class: deck
    grid-columns: 1
    grid-gap: 46
    c: C {class: ink; style.fill: "#24c9dc"}
    m: M {class: ink; style.fill: "#ff568c"}
    y: Y {class: ink; style.fill: "#f7cd38"}
    k: K {class: ink; style.fill: "#263847"; style.font-color: white}
  }

  press: Press bed {
    class: deck
    grid-columns: 1
    grid-gap: 66
    c: "" {class: roller; style.fill: "#24c9dc"}
    m: "" {class: roller; style.fill: "#ff568c"}
    y: "" {class: roller; style.fill: "#f7cd38"}
    k: "" {class: roller; style.fill: "#263847"}
  }

  inks.c -> press.c: {style.stroke: "#087a91"}
  inks.m -> press.m: {style.stroke: "#b81856"}
  inks.y -> press.y: {style.stroke: "#a8680c"}
  inks.k -> press.k: {style.stroke: "#263847"}

  inks.left: 0
  inks.top: 0
  press.left: 226
  press.top: 0
}

stock: Paper feed {
  shape: page
  label.near: center-center
  width: 168
  height: 120
  style: {multiple: true; fill: "#fff7df"; stroke: "#685a45"; font-size: 27; bold: true}
}

edition: Color proof {
  shape: page
  width: 190
  height: 184
  label.near: bottom-center
  style: {fill: "#fff7df"; stroke: "#685a45"; font-size: 27; bold: true}
  icon.near: top-center
  # The proof carries its own registration marks and overprinted colors.
  icon: "data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 130 111'>    <path d='M4 9h10m-5 -5v10' fill='none' stroke='%23263847' stroke-width='1.5'/>    <path d='M116 9h10m-5 -5v10' fill='none' stroke='%23263847' stroke-width='1.5'/>    <path d='M4 101h10m-5 -5v10' fill='none' stroke='%23263847' stroke-width='1.5'/>    <path d='M116 101h10m-5 -5v10' fill='none' stroke='%23263847' stroke-width='1.5'/>    <circle cx='51' cy='44' r='31' fill='%2320cade'/>    <circle cx='79' cy='44' r='31' fill='%23fb5087'/>    <circle cx='65' cy='68' r='31' fill='%23ffd339'/>    <path d='M65 71.66 A31 31 0 0 1 65 16.34 A31 31 0 0 1 65 71.66Z' fill='%23554b9c'/>    <path d='M34.06 69.96 A31 31 0 0 1 81.94 42.04 A31 31 0 0 1 34.06 69.96Z' fill='%2330a765'/>    <path d='M48.06 42.04 A31 31 0 0 1 95.94 69.96 A31 31 0 0 1 48.06 42.04Z' fill='%23f56c36'/>    <path d='M65 71.66 A31 31 0 0 1 48.06 42.04 A31 31 0 0 1 81.94 42.04 A31 31 0 0 1 65 71.66Z' fill='%23263847'/>    </svg>"
}

machine.left: 0
machine.top: 0
stock.left: 660
stock.top: 90
edition.left: 660
edition.top: 410

stock -> machine.press.c: {class: paper-path}
machine.press.c -> machine.press.m -> machine.press.y -> machine.press.k: {class: paper-path}
machine.press.k -> edition: {class: paper-path}

# In GIF exports, dots travel along the ink feeds and the paper path.
(** -> **)[*].style.animated: true
