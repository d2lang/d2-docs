vars: {
  d2-config: {
    animate-interval: 1s
    animate-duration: 800ms
  }
}

registry: Container registry {
  image: "Image v42\nQuarantined" {
    width: 160
    style.fill: moccasin
  }
}

steps: {
  verify-signature: {
    registry.image: "Image v42\nSignature verified" {style.fill: palegreen}
  }
}
