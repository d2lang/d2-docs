vars: {
  d2-config: {
    animate-interval: 1s
    animate-duration: 640ms
  }
  tls: lightcoral
}

cert: "*.shop.test\nExpired"
api: "api.shop.test" {style.fill: ${tls}}
pay: "pay.shop.test" {style.fill: ${tls}}
cert -> api
cert -> pay

steps: {
  renew: {
    cert.label: "*.shop.test\nRenewed"
    vars: {tls: palegreen}
  }
}
