vars: {
  d2-config: {
    animate-interval: 1s
    animate-duration: 800ms
  }
}

router: Payment router
a: Acquirer A
b: Acquirer B
router -> a: active {style.stroke: teal; style.stroke-width: 4}
router -> b: backup {style.stroke: silver; style.stroke-width: 4}

steps: {
  failover: {
    (router -> a)[0]: backup {style.stroke: silver}
    (router -> b)[0]: active {style.stroke: teal}
  }
}
