# Original icons and layout authored as editable D2.
# top/left are local to each container; TALA routes the connections.
vars: {d2-config: {layout-engine: tala}}
style.fill: "#120E29"
eyebrow: "AFTER HOURS SYSTEMS  /  POPULATION: PACKETS" {left: 0; top: 0; width: 1400; height: 35; shape: text; style.font-color: "#64E9F6"; style.font-size: 17; style.bold: true}
title: "Midnight is a transport protocol." {left: 0; top: 46; width: 1430; height: 80; shape: text; style.font-color: "#F9DFFF"; style.font-size: 43; style.bold: true}
deck: "Welcome to Synthwave City. Every district has a night job." {left: 0; top: 130; width: 1350; height: 36; shape: text; style.font-color: "#FF77DA"; style.font-size: 20; style.bold: false}
uptown: "UPTOWN / CLOUD DISTRICT" {
  left: 0
  top: 230
  width: 390
  height: 830
  label.near: top-left
  style: {fill: "#19122E"; stroke: "#443366"; font-color: "#F9DFFF"; font-size: 18; border-radius: 4; stroke-width: 2}
  tower: "SKYLINE / TOWER 01" {
    left: 0
    top: 30
    width: 270
    height: 670
    label.near: top-left
    style: {fill: "#211234"; stroke: "#FF77DA"; font-color: "#FF77DA"; font-size: 18; border-radius: 4; stroke-width: 2}
    gateway: "Ingress" {
      left: 0
      top: 15
      width: 150
      height: 125
      icon: ./icons/cloud.svg
      icon.near: top-center
      label.near: bottom-center
      style: {fill: "#211C40"; stroke: "#6D4392"; font-color: "#F9DFFF"; font-size: 17; border-radius: 16; stroke-width: 2}
    }
    cache: "Neon cache" {
      left: 0
      top: 220
      width: 150
      height: 125
      icon: ./icons/bolt.svg
      icon.near: top-center
      label.near: bottom-center
      style: {fill: "#211C40"; stroke: "#6D4392"; font-color: "#F9DFFF"; font-size: 17; border-radius: 16; stroke-width: 2}
    }
    core: "Core logic" {
      left: 0
      top: 425
      width: 150
      height: 125
      icon: ./icons/chip.svg
      icon.near: top-center
      label.near: bottom-center
      style: {fill: "#211C40"; stroke: "#6D4392"; font-color: "#F9DFFF"; font-size: 17; border-radius: 16; stroke-width: 2}
    }
  }
}
midtown: "MIDTOWN / TRANSIT DISTRICT" {
  left: 440
  top: 470
  width: 570
  height: 640
  label.near: top-left
  style: {fill: "#151B34"; stroke: "#443366"; font-color: "#F9DFFF"; font-size: 18; border-radius: 4; stroke-width: 2}
  civic: "City API" {
    left: 105
    top: 15
    width: 160
    height: 145
    icon: ./icons/building.svg
    icon.near: top-center
    label.near: bottom-center
    style: {fill: "#211C40"; stroke: "#6D4392"; font-color: "#F9DFFF"; font-size: 17; border-radius: 16; stroke-width: 2}
  }
  depot: "THE UNDERGROUND" {
    left: 0
    top: 240
    width: 450
    height: 280
    label.near: top-left
    style: {fill: "#132A3E"; stroke: "#3D7C91"; font-color: "#64E9F6"; font-size: 18; border-radius: 4; stroke-width: 2}
    train: "Event train" {
      left: 0
      top: 20
      width: 140
      height: 130
      icon: ./icons/rail.svg
      icon.near: top-center
      label.near: bottom-center
      style: {fill: "#211C40"; stroke: "#6D4392"; font-color: "#F9DFFF"; font-size: 17; border-radius: 16; stroke-width: 2}
    }
    switch: "Switchyard" {
      left: 190
      top: 20
      width: 140
      height: 130
      icon: ./icons/antenna.svg
      icon.near: top-center
      label.near: bottom-center
      style: {fill: "#211C40"; stroke: "#6D4392"; font-color: "#F9DFFF"; font-size: 17; border-radius: 16; stroke-width: 2}
    }
  }
}
eastside: "EASTSIDE / PLAY DISTRICT" {
  left: 1060
  top: 320
  width: 390
  height: 850
  label.near: top-left
  style: {fill: "#1D142F"; stroke: "#443366"; font-color: "#F9DFFF"; font-size: 18; border-radius: 4; stroke-width: 2}
  arcade: "OPEN ALL NIGHT" {
    left: 0
    top: 20
    width: 270
    height: 480
    label.near: top-left
    style: {fill: "#2B163D"; stroke: "#FF77DA"; font-color: "#FF77DA"; font-size: 18; border-radius: 4; stroke-width: 2}
    player: "Player one" {
      left: 0
      top: 10
      width: 150
      height: 135
      icon: ./icons/game.svg
      icon.near: top-center
      label.near: bottom-center
      style: {fill: "#211C40"; stroke: "#6D4392"; font-color: "#F9DFFF"; font-size: 17; border-radius: 16; stroke-width: 2}
    }
    npc: "Helpful NPC" {
      left: 0
      top: 225
      width: 150
      height: 135
      icon: ./icons/robot.svg
      icon.near: top-center
      label.near: bottom-center
      style: {fill: "#211C40"; stroke: "#6D4392"; font-color: "#F9DFFF"; font-size: 17; border-radius: 16; stroke-width: 2}
    }
  }
  drone: "Last-mile drone" {
    left: 60
    top: 585
    width: 150
    height: 145
    icon: ./icons/drone.svg
    icon.near: top-center
    label.near: bottom-center
    style: {fill: "#211C40"; stroke: "#6D4392"; font-color: "#F9DFFF"; font-size: 17; border-radius: 16; stroke-width: 2}
  }
}
uptown.tower.gateway -> uptown.tower.cache: {style.stroke: "#FF77DA"; style.stroke-width: 2; style.font-color: "#FF77DA"; style.font-size: 14; style.stroke-dash: 0}
uptown.tower.cache -> uptown.tower.core: {style.stroke: "#FF77DA"; style.stroke-width: 2; style.font-color: "#FF77DA"; style.font-size: 14; style.stroke-dash: 0}
uptown.tower.core -> midtown.civic: "request" {style.stroke: "#64E9F6"; style.stroke-width: 2; style.font-color: "#64E9F6"; style.font-size: 14; style.stroke-dash: 0}
midtown.civic -> midtown.depot.switch: {style.stroke: "#64E9F6"; style.stroke-width: 2; style.font-color: "#64E9F6"; style.font-size: 14; style.stroke-dash: 0}
midtown.depot.train -> midtown.depot.switch: {style.stroke: "#64E9F6"; style.stroke-width: 2; style.font-color: "#64E9F6"; style.font-size: 14; style.stroke-dash: 0}
midtown.depot.switch -> eastside.arcade.player: "play" {style.stroke: "#FF77DA"; style.stroke-width: 2; style.font-color: "#FF77DA"; style.font-size: 14; style.stroke-dash: 0}
eastside.arcade.player -> eastside.arcade.npc: {style.stroke: "#FF77DA"; style.stroke-width: 2; style.font-color: "#FF77DA"; style.font-size: 14; style.stroke-dash: 0}
eastside.arcade.npc -> eastside.drone: "dispatch" {style.stroke: "#64E9F6"; style.stroke-width: 2; style.font-color: "#64E9F6"; style.font-size: 14; style.stroke-dash: 0}
footer: "NIGHT SERVICE EVERY 8 ms         /         NO SLEEP. NO SINGLE POINT OF FAILURE." {left: 0; top: 1220; width: 1430; height: 40; shape: text; style.font-color: "#64E9F6"; style.font-size: 18; style.bold: false}

# Physical depth for the skyline; the transit layer stays flat.
uptown.style.3d: true
eastside.style.3d: true
uptown.tower.*.style.border-radius: 0
eastside.arcade.*.style.border-radius: 0
midtown.*.style.border-radius: 0

moon: "LOCAL TIME / 02:47" {
  left: 770
  top: 225
  width: 160
  height: 160
  shape: image
  icon: ./icons/sun.svg
  label.near: outside-bottom-center
  style.font-size: 15
  style.font-color: "#FF77DA"
}
midtown.depot.train.shape: hexagon
midtown.depot.train.width: 160
midtown.depot.train.label.near: outside-bottom-center
midtown.depot.train.icon.near: center-center
eastside.drone.shape: image
eastside.drone.label.near: outside-bottom-center
