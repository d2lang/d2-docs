      top: 0
      width: 195
      height: 115
      shape: rectangle
      style: {fill: "#131C22"; stroke: "#C6AC75"; stroke-width: 1; font-color: "#F0E6D2"; font-size: 18; border-radius: 0}
      icon: ./icons/shield.svg
      icon.near: top-center
      label.near: bottom-center
    }
    door -> session: {style: {stroke: "#C6AC75"; stroke-width: 2; stroke-dash: 0; font-color: "#C6AC75"; font-size: 15}}
  }
  service: "03  /  SERVICE FLOOR" {
    left: 0
    top: 332
    width: 625
    height: 235
    label.near: top-left
    style: {fill: "#27343B"; stroke: "#C6AC75"; stroke-width: 1; font-color: "#C6AC75"; font-size: 19; bold: true; border-radius: 0; stroke-dash: 0}
