      top: 0
      width: 195
      height: 115
      shape: rectangle
      style: {fill: "#131C22"; stroke: "#C6AC75"; stroke-width: 1; font-color: "#F0E6D2"; font-size: 18; border-radius: 0}
      icon: ./icons/server.svg
      icon.near: top-center
      label.near: bottom-center
