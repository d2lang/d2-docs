  suites.session -> service.room: {style: {stroke: "#C6AC75"; stroke-width: 2; stroke-dash: 0; font-color: "#C6AC75"; font-size: 15}}
  service.lift -> vaults.vault: {style: {stroke: "#C6AC75"; stroke-width: 2; stroke-dash: 0; font-color: "#C6AC75"; font-size: 15}}
}
watch: "Night watch\nContinuous review" {
  left: 1230
  top: 330
  width: 205
  height: 150
  shape: rectangle
  style: {fill: "#131C22"; stroke: "#C6AC75"; stroke-width: 1; font-color: "#F0E6D2"; font-size: 18; border-radius: 0}
  icon: ./icons/eye.svg
  icon.near: top-center
  label.near: bottom-center
}
expiry: "Keys expire.\nTrust does too." {
  left: 1230
  top: 710
  width: 205
  height: 150
  shape: rectangle
  style: {fill: "#131C22"; stroke: "#C6AC75"; stroke-width: 1; font-color: "#F0E6D2"; font-size: 18; border-radius: 0}
  icon: ./icons/clock.svg
  icon.near: top-center
  label.near: bottom-center
}
lobby.key -> hotel.suites.door: "check in" {style: {stroke: "#C6AC75"; stroke-width: 2; stroke-dash: 0; font-color: "#C6AC75"; font-size: 15}}
watch -> hotel.suites.session: {style: {stroke: "#C6AC75"; stroke-width: 2; stroke-dash: 5; font-color: "#C6AC75"; font-size: 15}}
hotel.vaults.book -> watch: {style: {stroke: "#C6AC75"; stroke-width: 2; stroke-dash: 5; font-color: "#C6AC75"; font-size: 15}}
policy: "NO MASTER KEY.\nNO VIP BYPASS." {
  shape: text
  left: 0
  top: 1095
  width: 315
  height: 100
  style: {font-color: "#F0E6D2"; font-size: 29; bold: true}
}
foot: "ACCESS IS GRANTED FOR A PURPOSE.   NEVER FOR A LIFETIME." {
  shape: text
  left: 0
  top: 1330
  width: 1350
  height: 30
  style: {font-color: "#C6AC75"; font-size: 15; bold: true}
}
