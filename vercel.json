{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npx --yes --package=yarn@1.22.22 -- yarn install --frozen-lockfile",
  "buildCommand": "DOCUSAURUS_IGNORE_SSG_WARNINGS=true npx --yes --package=yarn@1.22.22 -- yarn run prod",
  "outputDirectory": "build",
  "rewrites": [
    { "source": "/install.sh", "destination": "https://raw.githubusercontent.com/d2lang/d2/master/install.sh" },
    { "source": "/js/script.js", "destination": "https://plausible.io/js/script.js" },
    { "source": "/api/event", "destination": "https://plausible.io/api/event" }
  ],
  "headers": [
    {
      "source": "/assets/:path*",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
